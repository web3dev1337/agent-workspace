    "destructive": { "ack": "confirm-first" },
    "task": { "ack": "instant", "progress": "on-change", "done": "speak" },
    "query": { "ack": "none", "done": "speak" }
  },
  "realtimeManager": {
    "enabled": true,
    "minSecondsBetweenUpdates": 30,
    "speakInBackgroundMode": false
  }
}

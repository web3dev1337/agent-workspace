  "$comment": "Voice ladder configuration. Models per tier, thresholds, and feedback policy. Real identities do NOT live here - see ~/.orchestrator/voice-registry.json.",
  "tier2": {
    "url": "http://127.0.0.1:5742",
    "model": "~/AI-Models/Bonsai-1.7B.gguf",
    "confidenceThreshold": 0.6,
